# ─── Backend API ─────────────────────────────────────
# Base URL of the FastAPI backend. This Next app is a pure client of it.
API_URL="http://localhost:8000"
# Public base URL, visible to the browser. Same as API_URL when not proxied.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ─── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ScholarsCrib"

# ─── Admin auth (separate instance, separate cookie) ───
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_AUTH_SECRET=

# ─── Phone OTP (Twilio or Termii for Nigeria) ─────
# Termii is recommended for Nigerian phone numbers
# Get from: https://termii.com
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="ScholarsCrib"

# ─── Push notifications — generate once with: npx web-push generate-vapid-keys
# Rotating these keys invalidates every student's subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@scholarscrib.com

# ─── Billing ───────────────────────────────────────
# Billing lives on the backend (Paystack). The secret key never reaches this app.
PAYSTACK_SECRET_KEY="your-paystack-secret-key"

# Note: Google OAuth, email/password auth, the database connection, question
# providers, rate limiting and cron secrets all moved to the FastAPI backend.