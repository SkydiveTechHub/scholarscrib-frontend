# ─── Backend API ─────────────────────────────────────
# Base URL of the FastAPI backend, no trailing slash. This Next app is a pure
# client of it. For a local backend use http://localhost:8000.
API_URL="https://scholarscrib-backend.onrender.com"
# Public base URL, visible to the browser. Same as API_URL when not proxied.
NEXT_PUBLIC_API_URL="https://scholarscrib-backend.onrender.com"

# ─── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ScholarsCrib"

# ─── Feature switches ──────────────────────────────
# "true" shows the UI. The secrets behind these live on the backend.
NEXT_PUBLIC_BILLING_ENABLED="false"
NEXT_PUBLIC_PUSH_ENABLED="false"
# The backend's public VAPID key; needed for the browser to subscribe to push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ─── PostHog ───────────────────────────────────────
# Public project token and EU ingestion host. Both must be set or the browser
# SDK stays off. The token is public, but it still lives in env, not source.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ─── Tawk.to ───────────────────────────────────────
# Public property and widget IDs from the Tawk embed snippet. Both must be set
# or the chat bubble stays off. Same as PostHog: public, but not hardcoded.
NEXT_PUBLIC_TAWK_PROPERTY_ID=""
NEXT_PUBLIC_TAWK_WIDGET_ID=""
# Property API key from Tawk Admin → Property Settings. Server-only. Used to
# HMAC the student id for secure login (name/email). Omit to keep the bubble
# anonymous.
TAWK_API_KEY=""

# Note: auth, the database, Paystack, VAPID private keys, Termii, rate limiting
# and cron secrets all belong to the FastAPI backend. Never put them here.
